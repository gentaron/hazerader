{
  "mcpServers": {
    "infocollect-kb": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "github:gentaron/infocollect",
        "infocollect-kb"
      ],
      "env": {
        "INFOCOLLECT_KB_URL": "https://raw.githubusercontent.com/gentaron/infocollect/HEAD/docs/kb"
      }
    },
    "forge": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "github:gentaron/infocollect",
        "forge",
        "mcp"
      ]
    }
  }
}
